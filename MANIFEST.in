include install.ps1 LICENSE README.md README.en.md CHANGELOG.md CONTRIBUTING.md requirements.txt requirements-dev.txt
recursive-include docs *.md
recursive-include assets *.md *.jpg *.png
recursive-include tests *.py *.json *.html *.txt *.png *.zip
exclude .release-report.md
prune .delegate

recursive-include tools *.py *.json *.md
recursive-include packaging *.py *.spec *.iss *.ps1
recursive-include docs/screenshots *.png
